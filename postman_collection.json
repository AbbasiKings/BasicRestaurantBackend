    {
      "name": "11. Customer - Auth & Profile Module",
      "item": [
        {
          "name": "Send OTP (Dummy 123456)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"03230381827\"\n}" },
            "url": { "raw": "{{base_url}}/api/customer/auth/send-otp", "host": ["{{base_url}}"], "path": ["api", "customer", "auth", "send-otp"] }
          }
        },
        {
          "name": "Verify OTP (Saves customer_token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('customer_token', jsonData.token);",
                  "    console.log('Saved customer_token:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
