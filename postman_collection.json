    {
      "name": "1. Admin - Auth & Device Security Module",
      "item": [
        {
          "name": "Admin Sign In (admin@gmail.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('admin_token', jsonData.token);",
                  "    console.log('Saved admin_token:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gmail.com\",\n  \"password\": \"admin123\",\n  \"deviceId\": \"dev_postman_001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/sign-in",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "auth", "sign-in"]
            }
          }
        },
        {
          "name": "Admin Sign Out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_token}}" }],
            "url": {
